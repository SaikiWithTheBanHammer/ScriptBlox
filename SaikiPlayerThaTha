local dmList=make("ScrollingFrame",{Position=UDim2.fromOffset(0,58),Size=UDim2.new(1,0,1,-110),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=2,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y},dmContent)
make("UIListLayout",{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder},dmList)
local dmBar=make("Frame",{AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,0),Size=UDim2.new(1,0,0,42),BackgroundColor3=C.panel2,BorderSizePixel=0},dmContent)
corner(dmBar,18); outline(dmBar,C.line,.4)
local dmBox=make("TextBox",{Position=UDim2.fromOffset(11,0),Size=UDim2.new(1,-80,1,0),BackgroundTransparency=1,Text="",PlaceholderText="Private message…",PlaceholderColor3=C.muted,TextColor3=C.text,Font=Enum.Font.GothamMedium,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false},dmBar)
local dmSendBg=make("Frame",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-4,.5,0),Size=UDim2.fromOffset(55,32),BackgroundColor3=C.purple},dmBar)
corner(dmSendBg,16); gradient(dmSendBg,C.purple,C.blue)
local dmSend=make("TextButton",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="Send",TextColor3=C.white,Font=Enum.Font.GothamBold,TextSize=11,AutoButtonColor=false},dmSendBg)
local selected
local function clearDMs()
    for _,v in ipairs(dmList:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
end
local function addDM(who,msg,mine)
    local row=make("Frame",{Size=UDim2.new(1,-2,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1},dmList)
    local b=make("Frame",{Size=UDim2.new(.92,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Position=mine and UDim2.new(1,0,0,0) or UDim2.new(0,0,0,0),AnchorPoint=mine and Vector2.new(1,0) or Vector2.new(0,0),BackgroundColor3=mine and Color3.fromRGB(65,52,113) or C.panel2,BorderSizePixel=0},row)
    corner(b,10); make("UIPadding",{PaddingLeft=UDim.new(0,8),PaddingRight=UDim.new(0,8),PaddingTop=UDim.new(0,5),PaddingBottom=UDim.new(0,6)},b)
    label(b,who,UDim2.fromOffset(0,0),UDim2.new(1,0,0,12),Enum.Font.GothamBold,9,mine and C.blue or C.purple)
    make("TextLabel",{Position=UDim2.fromOffset(0,13),Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=msg,TextColor3=C.text,Font=Enum.Font.GothamMedium,TextSize=12,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top},b)
    task.defer(function() pcall(function() dmList.CanvasPosition=Vector2.new(0,math.max(0,dmList.AbsoluteCanvasSize.Y-dmList.AbsoluteSize.Y)) end) end)
end
local function choosePlayer(p)
    selected=p
    dmTarget.Text="DM  •  "..p.DisplayName
    dmStatus.Text="@"..p.Name.."  •  local preview only"
    clearDMs()
end
local function rebuildPlayers()
    for _,v in ipairs(playerList:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local list=Players:GetPlayers()
    table.sort(list,function(a,b) return a.Name:lower()<b.Name:lower() end)
    for _,p in ipairs(list) do
        if p~=LP then
            local b=make("TextButton",{Size=UDim2.new(1,-2,0,32),BackgroundColor3=(selected==p) and Color3.fromRGB(65,52,113) or C.panel,Text=p.DisplayName,TextColor3=C.text,Font=Enum.Font.GothamMedium,TextSize=10,TextTruncate=Enum.TextTruncate.AtEnd,AutoButtonColor=false},playerList)
            corner(b,8)
            b.Activated:Connect(function() choosePlayer(p) end)
        end
    end
end
local function submitDM()
    local txt=dmBox.Text:gsub("^%s+",""):gsub("%s+$","")
    if txt=="" then return end
    if not selected or not selected.Parent then dmStatus.Text="Select a player first."; return end
    addDM(LP.DisplayName or LP.Name,txt,true)
    dmBox.Text=""
    dmStatus.Text="PREVIEW ONLY • not delivered"
end
dmSend.Activated:Connect(submitDM)
dmBox.FocusLost:Connect(function(enter) if enter then submitDM() end end)

local current=1
local function switchTab(i)
    current=i
    chatPage.Visible=i==1; dmPage.Visible=i==2
    activePill:TweenPosition(UDim2.new((i-1)*.5,3,0,3),Enum.EasingDirection.Out,Enum.EasingStyle.Quad,.18,true)
    activePill.Size=UDim2.new(.5,-6,1,-6)
    for k,b in ipairs(tabs) do b.TextColor3=(k==i) and C.white or C.muted end
    if i==2 then rebuildPlayers() end
end
tabs[1].Activated:Connect(function() switchTab(1) end)
tabs[2].Activated:Connect(function() switchTab(2) end)

local close=make("TextButton",{AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-10,0,49),Size=UDim2.fromOffset(24,18),BackgroundTransparency=1,Text="×",TextColor3=C.muted,Font=Enum.Font.GothamBold,TextSize=18,AutoButtonColor=false},win)
local isOpen=false
local function setOpen(v)
    isOpen=v
    if v then
        win.Visible=true; win.BackgroundTransparency=1
        TweenService:Create(win,TweenInfo.new(.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=.06}):Play()
    else
        TweenService:Create(win,TweenInfo.new(.15),{BackgroundTransparency=1}):Play()
        task.delay(.16,function() if not isOpen and win.Parent then win.Visible=false end end)
    end
end
launcher.Activated:Connect(function() setOpen(not isOpen) end)
close.Activated:Connect(function() setOpen(false) end)

-- Drag the window from the title area, without requiring executor-only input hooks.
local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        dragging=true; dragStart=input.Position; startPos=win.Position
        input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then dragging=false end end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
        local d=input.Position-dragStart
        win.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
    end
end)
Players.PlayerAdded:Connect(function() if dmPage.Visible then rebuildPlayers() end end)
Players.PlayerRemoving:Connect(function(p) if selected==p then selected=nil;dmTarget.Text="Select a player";dmStatus.Text="Private messages are disabled until official release." end; if dmPage.Visible then rebuildPlayers() end end)

print("[SAIKI RECHAT] Chat + DM GUI loaded. Firebase disabled until official release.")
