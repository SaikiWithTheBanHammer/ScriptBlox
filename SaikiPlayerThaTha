-- Saiki Chat | Standalone chat GUI
-- Firebase is intentionally not connected. Private DMs are local previews until an official backend is released.
-- Server chat uses Roblox TextChatService when available. Music plays locally for this client.

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local old = playerGui:FindFirstChild("SaikiChatGUI")
if old then old:Destroy() end

local C = {
  bg = Color3.fromRGB(242,245,250), panel = Color3.fromRGB(255,255,255),
  red = Color3.fromRGB(48,105,190), deep = Color3.fromRGB(28,61,112),
  pale = Color3.fromRGB(229,238,250), text = Color3.fromRGB(30,38,50),
  muted = Color3.fromRGB(105,117,135), line = Color3.fromRGB(210,222,238),
  green = Color3.fromRGB(35,125,80)
}
local gui = Instance.new("ScreenGui")
gui.Name = "SaikiChatGUI"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = false; gui.Parent = playerGui

local function make(class, props, parent)
  local o = Instance.new(class)
  for k,v in pairs(props or {}) do o[k] = v end
  o.Parent = parent
  return o
end
local function corner(o, r) make("UICorner", {CornerRadius=UDim.new(0,r or 10)}, o) end
local function stroke(o, color, thick) make("UIStroke", {Color=color or C.line, Thickness=thick or 1}, o) end
local function label(parent, text, size, pos, font, color)
 return make("TextLabel", {BackgroundTransparency=1, Text=text, TextSize=size or 14, Position=pos or UDim2.new(), Size=UDim2.new(1,0,0,24), Font=font or Enum.Font.Gotham, TextColor3=color or C.text, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center}, parent)
end
local function button(parent, text, size, pos, primary)
 local b=make("TextButton", {Text=text, Size=size, Position=pos, BackgroundColor3=primary and C.red or C.pale, TextColor3=primary and Color3.new(1,1,1) or C.deep, Font=Enum.Font.GothamSemibold, TextSize=13, AutoButtonColor=true, BorderSizePixel=0}, parent)
 corner(b,8); return b
end
local function textbox(parent, placeholder, size, pos)
 local t=make("TextBox", {Text="", PlaceholderText=placeholder, ClearTextOnFocus=false, Size=size, Position=pos, BackgroundColor3=Color3.fromRGB(255,252,252), TextColor3=C.text, PlaceholderColor3=C.muted, Font=Enum.Font.Gotham, TextSize=13, BorderSizePixel=0, TextXAlignment=Enum.TextXAlignment.Left}, parent)
 corner(t,8); stroke(t,C.line,1); make("UIPadding",{PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,8)},t); return t
end

local main=make("Frame", {Name="Main", Size=UDim2.fromOffset(560,470), Position=UDim2.new(0.5,-280,0.5,-235), BackgroundColor3=C.bg, BorderSizePixel=0}, gui)
corner(main,15); stroke(main,C.red,1.5)
local top=make("Frame",{Size=UDim2.new(1,0,0,66),BackgroundColor3=C.red,BorderSizePixel=0},main); corner(top,14)
make("Frame",{Position=UDim2.new(0,0,1,-14),Size=UDim2.new(1,0,0,14),BackgroundColor3=C.red,BorderSizePixel=0},top)
label(top,"SAIKI CHAT",20,UDim2.new(0,18,0,8),Enum.Font.GothamBlack,Color3.new(1,1,1)).Size=UDim2.new(1,-90,0,27)
label(top,"SERVER CHAT  •  PRIVATE MESSAGES  •  MUSIC",10,UDim2.new(0,20,0,36),Enum.Font.GothamMedium,Color3.fromRGB(220,235,255)).Size=UDim2.new(1,-100,0,18)
local min=button(top,"—",UDim2.fromOffset(32,28),UDim2.new(1,-76,0,17),false); min.BackgroundColor3=Color3.fromRGB(255,255,255); min.TextColor3=C.red
local close=button(top,"×",UDim2.fromOffset(32,28),UDim2.new(1,-38,0,17),false); close.BackgroundColor3=Color3.fromRGB(255,255,255); close.TextColor3=C.red

local status=label(main,"Firebase disabled until official release.",12,UDim2.new(0,18,0,72),Enum.Font.GothamSemibold,C.red); status.Size=UDim2.new(1,-36,0,20)
local tabs=make("Frame",{BackgroundTransparency=1,Position=UDim2.new(0,16,0,98),Size=UDim2.new(1,-32,0,36)},main)
local tabNames={"SERVER CHAT","PRIVATE DM","MUSIC PLAYER"}; local tabButtons={}
for i,n in ipairs(tabNames) do
 local b=button(tabs,n,UDim2.new(1/3,-6,1,0),UDim2.new((i-1)/3,(i-1)*3,0,0),i==1); b.TextSize=11; tabButtons[i]=b
end
local content=make("Frame",{BackgroundColor3=C.panel,Position=UDim2.new(0,16,0,142),Size=UDim2.new(1,-32,1,-158),BorderSizePixel=0},main); corner(content,11); stroke(content,C.line,1)
local pages={}
for _,n in ipairs(tabNames) do pages[n]=make("Frame",{Name=n,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Visible=false},content) end
pages[tabNames[1]].Visible=true
local function setTab(which)
 for i,n in ipairs(tabNames) do pages[n].Visible=(n==which); tabButtons[i].BackgroundColor3=(n==which) and C.red or C.pale; tabButtons[i].TextColor3=(n==which) and Color3.new(1,1,1) or C.deep end
end
for i,n in ipairs(tabNames) do tabButtons[i].MouseButton1Click:Connect(function() setTab(n) end) end

-- Server chat panel: uses the Roblox chat service; does not use Firebase.
local chat=pages["SERVER CHAT"]
label(chat,"SERVER CHAT",15,UDim2.new(0,14,0,10),Enum.Font.GothamBold,C.deep)
label(chat,"Messages are sent through Roblox chat when available.",11,UDim2.new(0,14,0,33),Enum.Font.Gotham,C.muted)
local log=make("ScrollingFrame",{Position=UDim2.new(0,12,0,60),Size=UDim2.new(1,-24,1,-118),BackgroundColor3=Color3.fromRGB(255,249,250),BorderSizePixel=0,ScrollBarThickness=4,CanvasSize=UDim2.new()},chat); corner(log,8)
local logLayout=make("UIListLayout",{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder},log)
make("UIPadding",{PaddingTop=UDim.new(0,8),PaddingLeft=UDim.new(0,9),PaddingRight=UDim.new(0,7),PaddingBottom=UDim.new(0,8)},log)
local function addLine(text, color)
 local l=make("TextLabel",{BackgroundTransparency=1,Text=text,TextColor3=color or C.text,TextSize=12,Font=Enum.Font.Gotham,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,AutomaticSize=Enum.AutomaticSize.Y,Size=UDim2.new(1,-6,0,18)},log)
 l.LayoutOrder=#log:GetChildren(); task.defer(function() log.CanvasSize=UDim2.new(0,0,0,logLayout.AbsoluteContentSize.Y+18); log.CanvasPosition=Vector2.new(0,math.max(0,log.CanvasSize.Y.Offset-log.AbsoluteWindowSize.Y)) end)
end
local chatInput=textbox(chat,"Type a server message…",UDim2.new(1,-106,0,38),UDim2.new(0,12,1,-49))
local send=button(chat,"SEND",UDim2.fromOffset(82,38),UDim2.new(1,-94,1,-49),true)
local function sendChat()
 local msg=chatInput.Text:gsub("^%s+",""):gsub("%s+$","")
 if msg=="" then return end
 local channel
 pcall(function() channel=TextChatService:WaitForChild("TextChannels",2):FindFirstChild("RBXGeneral") end)
 if channel and channel:IsA("TextChannel") then
  local ok,err=pcall(function() channel:SendAsync(msg) end)
  if ok then addLine("You: "..msg,C.green); chatInput.Text="" else addLine("Chat send failed: "..tostring(err),C.red) end
 else
  addLine("Roblox TextChatService channel unavailable. Message not sent.",C.red)
 end
end
send.MouseButton1Click:Connect(sendChat); chatInput.FocusLost:Connect(function(enter) if enter then sendChat() end end)
pCallOk = pcall(function()
 TextChatService.MessageReceived:Connect(function(message)
  if not message.TextSource or message.TextSource.UserId ~= player.UserId then
   local name=message.TextSource and message.TextSource.Name or "System"
   addLine(name..": "..message.Text)
  end
 end)
end)
addLine("Welcome. Firebase disabled until official release.",C.red)

-- Private DM panel is UI-only until an official backend/remote is added.
local dm=pages["PRIVATE DM"]
label(dm,"PRIVATE DIRECT MESSAGE",15,UDim2.new(0,14,0,10),Enum.Font.GothamBold,C.deep)
label(dm,"Private delivery is disabled until official release.",11,UDim2.new(0,14,0,34),Enum.Font.Gotham,C.red)
label(dm,"Recipient username",12,UDim2.new(0,14,0,70),Enum.Font.GothamSemibold,C.text)
local recipient=textbox(dm,"Enter exact Roblox username",UDim2.new(1,-28,0,38),UDim2.new(0,14,0,94))
label(dm,"Message",12,UDim2.new(0,14,0,144),Enum.Font.GothamSemibold,C.text)
local dmText=textbox(dm,"Write a private message…",UDim2.new(1,-28,0,74),UDim2.new(0,14,0,168)); dmText.TextYAlignment=Enum.TextYAlignment.Top; dmText.MultiLine=true
local dmSend=button(dm,"PREVIEW MESSAGE",UDim2.new(1,-28,0,38),UDim2.new(0,14,0,254),true)
local dmPreview=label(dm,"Your DM preview will appear here. It will not be delivered.",11,UDim2.new(0,14,0,302),Enum.Font.Gotham,C.muted); dmPreview.Size=UDim2.new(1,-28,0,50); dmPreview.TextWrapped=true; dmPreview.TextYAlignment=Enum.TextYAlignment.Top
dmSend.MouseButton1Click:Connect(function()
 local who=recipient.Text:gsub("^%s+",""):gsub("%s+$",""); local msg=dmText.Text:gsub("^%s+",""):gsub("%s+$","")
 if who=="" or msg=="" then dmPreview.Text="Enter a recipient and message first."; return end
 dmPreview.Text="LOCAL PREVIEW → @"..who.."\n"..msg.."\n\nNot delivered: Firebase disabled until official release."
end)

-- Music player is local to this client. Enter a Roblox audio asset ID.
local music=pages["MUSIC PLAYER"]
label(music,"LOCAL MUSIC PLAYER",15,UDim2.new(0,14,0,10),Enum.Font.GothamBold,C.deep)
label(music,"Plays audio locally on your client. Availability depends on Roblox audio permissions.",11,UDim2.new(0,14,0,34),Enum.Font.Gotham,C.muted).Size=UDim2.new(1,-28,0,30)
label(music,"Audio asset ID",12,UDim2.new(0,14,0,70),Enum.Font.GothamSemibold,C.text)
local asset=textbox(music,"Example: 1843529634",UDim2.new(1,-28,0,38),UDim2.new(0,14,0,94))
local play=button(music,"PLAY",UDim2.new(0.32,-8,0,38),UDim2.new(0,14,0,146),true)
local pause=button(music,"PAUSE / RESUME",UDim2.new(0.36,-8,0,38),UDim2.new(0.32,0,0,146),false)
local stop=button(music,"STOP",UDim2.new(0.32,-8,0,38),UDim2.new(0.68,8,0,146),false)
local musicStatus=label(music,"Ready — enter an asset ID.",12,UDim2.new(0,14,0,196),Enum.Font.Gotham,C.muted); musicStatus.Size=UDim2.new(1,-28,0,32); musicStatus.TextWrapped=true
local sound=SoundService:FindFirstChild("SaikiChatLocalMusic") or Instance.new("Sound")
sound.Name="SaikiChatLocalMusic"; sound.Volume=0.5; sound.Looped=false; sound.Parent=SoundService
play.MouseButton1Click:Connect(function()
 local id=asset.Text:match("%d+")
 if not id then musicStatus.Text="Enter a numeric Roblox audio asset ID."; return end
 sound:Stop(); sound.SoundId="rbxassetid://"..id; sound.TimePosition=0
 local ok,err=pcall(function() sound:Play() end)
 if ok then musicStatus.Text="Loading audio ID "..id.."…" else musicStatus.Text="Could not play audio: "..tostring(err) end
end)
pause.MouseButton1Click:Connect(function()
 if sound.IsPlaying then sound:Pause(); musicStatus.Text="Paused." else
  if sound.SoundId~="" then sound:Resume(); musicStatus.Text="Playing / resuming." else musicStatus.Text="Enter an asset ID and press PLAY." end
 end
end)
stop.MouseButton1Click:Connect(function() sound:Stop(); musicStatus.Text="Stopped." end)

-- Minimize/restore and drag.
local minimized=false
min.MouseButton1Click:Connect(function()
 minimized=not minimized
 for _,child in ipairs(main:GetChildren()) do if child:IsA("GuiObject") and child~=top then child.Visible=not minimized end end
 main.Size=minimized and UDim2.fromOffset(560,66) or UDim2.fromOffset(560,470)
 min.Text=minimized and "+" or "—"
end)
close.MouseButton1Click:Connect(function() gui.Enabled=false end)
local dragging,dragStart,startPos=false,nil,nil
 top.InputBegan:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true; dragStart=input.Position; startPos=main.Position end
 end)
UserInputService.InputChanged:Connect(function(input)
  if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
   local delta=input.Position-dragStart; main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
  end
 end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
