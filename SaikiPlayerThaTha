local function buildMessageArea(page, placeholder, isDM)
    local list=make("ScrollingFrame",{Position=UDim2.fromOffset(8,8),Size=UDim2.new(1,-16,1,-62),BackgroundTransparency=1,BorderSizePixel=0,
        ScrollBarThickness=3,ScrollBarImageColor3=C.purple,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y},page)
    make("UIListLayout",{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder},list)
    make("UIPadding",{PaddingLeft=UDim.new(0,5),PaddingRight=UDim.new(0,5),PaddingTop=UDim.new(0,3),PaddingBottom=UDim.new(0,4)},list)
    local inputBar=make("Frame",{AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-9),Size=UDim2.new(1,-18,0,42),BackgroundColor3=C.panel2,BorderSizePixel=0},page)
    corner(inputBar,20); outline(inputBar,C.line,.35)
    local box=make("TextBox",{Position=UDim2.fromOffset(14,0),Size=UDim2.new(1,-90,1,0),BackgroundTransparency=1,Text="",PlaceholderText=placeholder,
        PlaceholderColor3=C.muted,TextColor3=C.text,Font=Enum.Font.GothamMedium,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,
        ClearTextOnFocus=false,TextTruncate=Enum.TextTruncate.AtEnd},inputBar)
    local sendBg=make("Frame",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-5,.5,0),Size=UDim2.fromOffset(60,32),BackgroundColor3=C.purple},inputBar)
    corner(sendBg,16); gradient(sendBg,C.purple,C.blue,0)
    local send=make("TextButton",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="Send",TextColor3=C.white,Font=Enum.Font.GothamBold,TextSize=12,AutoButtonColor=false},sendBg)
    local function addMessage(who, msg, mine)
        local row=make("Frame",{Size=UDim2.new(1,-4,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1},list)
        local bubbleFrame=make("Frame",{AutomaticSize=Enum.AutomaticSize.Y,Size=UDim2.new(.86,0,0,0),Position=mine and UDim2.new(1,-2,0,0) or UDim2.new(0,0,0,0),AnchorPoint=mine and Vector2.new(1,0) or Vector2.new(0,0),BackgroundColor3=mine and Color3.fromRGB(65,52,113) or C.panel2,BorderSizePixel=0},row)
        corner(bubbleFrame,12)
        make("UIPadding",{PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,10),PaddingTop=UDim.new(0,6),PaddingBottom=UDim.new(0,7)},bubbleFrame)
        local whoLabel=make("TextLabel",{Size=UDim2.new(1,0,0,14),BackgroundTransparency=1,Text=who,TextColor3=mine and C.blue or C.purple,Font=Enum.Font.GothamBold,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left},bubbleFrame)
        local msgLabel=make("TextLabel",{Position=UDim2.fromOffset(0,15),Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=msg,TextColor3=C.text,Font=Enum.Font.GothamMedium,TextSize=13,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top},bubbleFrame)
        msgLabel.Size=UDim2.new(1,0,0,0)
        task.defer(function() pcall(function() list.CanvasPosition=Vector2.new(0,math.max(0,list.AbsoluteCanvasSize.Y-list.AbsoluteSize.Y)) end) end)
    end
    local function submit()
        local txt=box.Text:gsub("^%s+",""):gsub("%s+$","")
        if txt=="" then return end
        addMessage(LP.DisplayName or LP.Name,txt,true)
        box.Text=""
        status.Text="PREVIEW ONLY • FIREBASE DISABLED"
    end
    send.Activated:Connect(submit)
    box.FocusLost:Connect(function(enter) if enter then submit() end end)
    return {list=list,box=box,addMessage=addMessage}
end

