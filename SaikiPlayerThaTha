local function make(class, props, par)
    local obj = Instance.new(class)
    for k,v in pairs(props or {}) do obj[k] = v end
    obj.Parent = par
    return obj
end
local function corner(obj, r) make("UICorner", {CornerRadius=UDim.new(0,r or 12)}, obj) end
local function outline(obj, color, trans, thick)
    make("UIStroke", {Color=color or C.line, Transparency=trans or .25, Thickness=thick or 1}, obj)
end
local function gradient(obj, a, b, rotation)
    make("UIGradient", {Color=ColorSequence.new(a or C.purple,b or C.blue),Rotation=rotation or 0},obj)
end
local function label(parentObj, text, pos, size, font, textSize, color, align)
    return make("TextLabel", {BackgroundTransparency=1,Text=text,Position=pos,Size=size,Font=font or Enum.Font.GothamMedium,
        TextSize=textSize or 12,TextColor3=color or C.text,TextXAlignment=align or Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Center,TextWrapped=false},parentObj)
end

